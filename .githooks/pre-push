#!/usr/bin/env bash
# Mandatory pre-push secret wall. Enable once per clone:  git config core.hooksPath .githooks
# Blocks the push on any gitleaks finding (full history) or deny-list hit. Never bypass with --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
command -v gitleaks >/dev/null || { echo "pre-push: gitleaks not installed (brew install gitleaks) — push blocked"; exit 1; }
gitleaks git --redact --no-banner --exit-code 1 .
python3 scripts/denylist_check.py
